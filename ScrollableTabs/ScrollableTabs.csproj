<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/13.0.0">
  <!-- Project settings -->
  <!-- 台服移植：SDK 15 是從 csproj 屬性產生 manifest，SDK 13 的 DalamudPackager 讀的是專案目錄下的
       <AssemblyName>.json。名稱／簡介／說明一律以 ScrollableTabs.json 為準，不要在這裡重複一份。 -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Version>1.0.0.0</Version>
    <Authors>Haselnussbomber</Authors>
    <RepositoryUrl>https://github.com/ffxiv-tc-port/ScrollableTabs</RepositoryUrl>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Assets -->
  <ItemGroup>
    <None Condition="'$(Configuration)' == 'Debug'" Include="Assets\Icon.png" Link="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- NuGet dependencies -->
  <ItemGroup>
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
